# Copy to .env and fill in. Never commit the real file.

# Points at the docker-compose postgres service. Port 5433 (not 5432) to
# avoid colliding with any other local Postgres instance already bound to
# the default port.
TB_DATABASE_URL=postgres://tallybook:tallybook@localhost:5433/tallybook?sslmode=disable

TB_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
TB_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
TB_PRICE_BOOK_ID=
TB_STATEMENT_REGISTRY_ID=
TB_OPERATOR_ADDRESS=
# "env" or "file". Exactly one of TB_OPERATOR_SECRET / TB_OPERATOR_SECRET_PATH
# must be set, matching this mode — the other must be left unset.
TB_OPERATOR_SECRET_SOURCE=env
TB_OPERATOR_SECRET=
TB_OPERATOR_SECRET_PATH=

TB_SAFETY_MARGIN_LEDGERS=1440
TB_MAX_EXPOSURE=10000000
TB_MAX_EXPOSURE_AGE=24h
# How long a billing period may stay open before it's closed on calendar
# grounds alone, independent of any price change. 720h = 30 days.
TB_PERIOD_DURATION=720h
TB_SETTLER_TICK=30s
TB_INDEXER_START_LEDGER=4590000
TB_INDEXER_MAX_CONSECUTIVE_FAILURES=3
TB_COLLECTOR_ADDR=:8080
TB_LOG_LEVEL=info
# Shared HTTP server timeouts: headers 5s, request read 2m, response write 5m,
# and keep-alive idle 2m. Write timeout is long enough for slow API responses.
TB_HTTP_READ_HEADER_TIMEOUT=5s
TB_HTTP_READ_TIMEOUT=2m
TB_HTTP_WRITE_TIMEOUT=5m
TB_HTTP_IDLE_TIMEOUT=2m
